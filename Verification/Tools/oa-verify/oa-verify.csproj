<Project Sdk="Microsoft.NET.Sdk">
  <!-- The quality gate as a command-line tool, for machines without Unity. Usage is in Verification/README.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>OrbitalAnte.Verification.Cli</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="../../../unity/Assets/OrbitalAnte/Verification/Rules/*.cs" />
  </ItemGroup>
</Project>
