# Large binary game assets go through Git LFS.
unity/Assets/**/*.glb  filter=lfs diff=lfs merge=lfs -text
unity/Assets/**/*.gltf filter=lfs diff=lfs merge=lfs -text
unity/Assets/**/*.fbx  filter=lfs diff=lfs merge=lfs -text
unity/Assets/**/*.obj  filter=lfs diff=lfs merge=lfs -text
unity/Assets/**/*.blend filter=lfs diff=lfs merge=lfs -text
unity/Assets/**/*.png  filter=lfs diff=lfs merge=lfs -text
unity/Assets/**/*.jpg  filter=lfs diff=lfs merge=lfs -text
unity/Assets/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
unity/Assets/**/*.tga  filter=lfs diff=lfs merge=lfs -text
unity/Assets/**/*.psd  filter=lfs diff=lfs merge=lfs -text
unity/Assets/**/*.exr  filter=lfs diff=lfs merge=lfs -text
unity/Assets/**/*.hdr  filter=lfs diff=lfs merge=lfs -text
unity/Assets/**/*.wav  filter=lfs diff=lfs merge=lfs -text
unity/Assets/**/*.ogg  filter=lfs diff=lfs merge=lfs -text
unity/Assets/**/*.mp3  filter=lfs diff=lfs merge=lfs -text

# Unity text assets and code keep Unix line endings.
*.cs     text eol=lf
*.asmdef text eol=lf
*.json   text eol=lf
*.meta   text eol=lf
*.unity  text eol=lf
*.asset  text eol=lf
*.prefab text eol=lf
*.mat    text eol=lf

# The game's own rendered audio is committed as ordinary files for now (about 60 MB), so a plain
# `git pull` is enough on the Steam Deck and nobody needs Git LFS installed to hear the game.
# Revisit when the library grows (see docs/reports/audio-slice.md).
unity/Assets/OrbitalAnte/Resources/Audio/**/*.wav -filter -diff -merge -text
unity/Assets/OrbitalAnte/Resources/Audio/**/*.ogg -filter -diff -merge -text
