// Balance simulator (CLAUDE.md section 18.8). A model of how players earn
// points, run through the real points rules (rules.ron, run.ron, perks.ron,
// antes.ron). Everything it outputs is SIMULATED: real playtest scores
// override it. These are assumptions about players, not game rules.
(
    runs_per_profile: 10000,
    step_s: 5.0,
    // Things to do. `minutes` is time per action at efficiency 1.0 (travel
    // included). Supply: `per_ante` (+ `per_ante_growth` x (ante - 1)) or
    // `per_run` (one-off things like first discoveries). `success` is the
    // chance the action pays (scaled by profile skill).
    activities: {
        "kill_t1":       (source: "kill_t1", base: (25, 25), minutes: 0.35, per_ante: 6.0, per_ante_growth: 3.0, success: 0.85, limb_chance: 0.6, disarm_chance: 0.3),
        "kill_t2":       (source: "kill_t2", base: (60, 60), minutes: 0.6, per_ante: 1.0, per_ante_growth: 1.5, success: 0.75, limb_chance: 0.6, disarm_chance: 0.3, from_ante: 2),
        "kill_t3":       (source: "kill_t3", base: (150, 150), minutes: 1.2, per_ante: 0.0, per_ante_growth: 1.0, success: 0.6, limb_chance: 0.5, disarm_chance: 0.2, from_ante: 6),
        "base_clear":    (source: "base_clear", base: (150, 900), minutes: 1.0, per_ante: 1.0, per_ante_growth: 0.4, success: 0.7, needs_kills: 4),
        "discovery":     (source: "discovery", base: (30, 80), minutes: 1.2, per_run: 120, success: 1.0, adds_time_s: 20.0),
        "first_landing": (source: "first_landing", base: (80, 80), minutes: 0.9, per_run: 13, success: 1.0, adds_time_s: 20.0),
        "satellite":     (source: "satellite", base: (300, 300), minutes: 2.5, per_ante: 1.0, per_ante_growth: 0.5, success: 0.85),
        "salvage":       (source: "salvage", base: (50, 400), minutes: 2.5, per_ante: 99.0, success: 0.9),
        "bounty":        (source: "bounty", base: (600, 1500), minutes: 4.5, per_ante: 1.0, per_ante_growth: 0.5, success: 0.65, from_ante: 2),
    },
    // Contracts: extra minutes to finish one by risk level (most of the
    // work overlaps normal play: kills, landings, discoveries) and the base
    // chance it comes off.
    contract_minutes: [1.0, 2.0, 3.5],
    contract_success: [0.9, 0.75, 0.6],
    // The 3 main routes (section 3: at least 3 viable ways to hit each
    // target). Weights pick what to do next; contracts are always taken.
    routes: {
        Fighter:  {"kill_t1": 5.0, "kill_t2": 3.0, "kill_t3": 2.0, "base_clear": 2.0, "discovery": 1.0, "salvage": 0.5},
        Explorer: {"discovery": 4.0, "first_landing": 2.0, "satellite": 2.0, "salvage": 1.5, "kill_t1": 0.5},
        Hunter:   {"bounty": 3.0, "kill_t1": 1.0, "discovery": 1.0, "satellite": 0.5, "salvage": 0.5},
    },
    // Which perk tags help which route (each matching perk: +perk_efficiency).
    route_tags: {
        Fighter: [Heat, Chaos],
        Explorer: [Speed, Scavenger, Salvage],
        Hunter: [Stealth, Diplomacy],
    },
    perk_efficiency: 0.06,
    // Each attribute level bought raises efficiency by this much.
    attribute_efficiency: 0.05,
    profiles: [
        (
            name: "Novice",
            efficiency: 1.5, growth_per_ante: 0.0,
            wasted_time: 0.15,
            // Deaths per minute at ante 1, multiplied by hazard_growth each ante.
            hazard_per_min: 0.006, hazard_growth: 1.55,
            skill: 0.85,
            perk_choice: Random, keep_wallet_t: 0.0, cash_out: false, take_contracts: 1,
        ),
        (
            name: "Average",
            efficiency: 1.3, growth_per_ante: 0.08,
            wasted_time: 0.15,
            hazard_per_min: 0.005, hazard_growth: 1.45,
            skill: 0.9,
            perk_choice: Mixed, keep_wallet_t: 0.2, cash_out: false, take_contracts: 2,
        ),
        (
            name: "Expert",
            efficiency: 1.75, growth_per_ante: 0.09,
            wasted_time: 0.05,
            hazard_per_min: 0.004, hazard_growth: 1.4,
            skill: 1.0,
            perk_choice: RouteMatch, keep_wallet_t: 0.5, cash_out: true, take_contracts: 2,
        ),
    ],
    // Pass criteria (section 18.8).
    targets: (
        novice_median_death: (3.0, 4.0),
        expert_win_rate: (0.18, 0.32),
        max_share_in_expert_wins: 0.4,
        // A perk is "dominant" if it takes this share of all picks in Expert
        // wins (even spread over 14 perks is about 7%).
        max_perk_pick_share: 0.2,
        average_ante1_minutes: (7.5, 10.5),
    ),
)
