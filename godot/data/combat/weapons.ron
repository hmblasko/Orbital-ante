// Hand weapons (CLAUDE.md section 7). Starting values for the vertical
// slice; tune freely. Display names are working names (Matthew approves
// final ones). Damage is in health points: enemies and the player have
// 100 health at tier 1 (see enemies.ron and player/suit.ron).
(
    weapons: [
        (
            id: "rifle",
            name_key: "WEAPON_RIFLE",
            kind: Gun,
            // Reliable all-rounder (AK spoof).
            damage: 14.0,
            pellets: 1,
            spread_deg: 0.9,
            aim_spread_deg: 0.25,
            moving_spread_deg: 2.5,
            fire_interval_s: 0.11,
            automatic: true,
            magazine: 30,
            start_reserve: 90,
            max_reserve: 150,
            reload_s: 1.7,
            range_m: 140.0,
            falloff_start_m: 40.0,
            falloff_min: 0.5,
            impulse: 3.0,
            kick_deg: 0.7,
            hit_stop_s: 0.0,
            // Ammo a fallen enemy carrying this gun drops.
            drop_ammo: (12, 24),
            beam_color: (1.0, 0.82, 0.45),
            beam_width: 0.025,
            beam_life_s: 0.06,
            muzzle_light: 2.5,
            noise_m: 90.0,
        ),
        (
            id: "laser_shotgun",
            name_key: "WEAPON_LASER_SHOTGUN",
            kind: Gun,
            // Double-barrel laser shotgun: close-range gib machine.
            damage: 11.0,
            pellets: 10,
            spread_deg: 6.5,
            aim_spread_deg: 4.5,
            moving_spread_deg: 7.5,
            fire_interval_s: 0.35,
            automatic: false,
            magazine: 2,
            start_reserve: 16,
            max_reserve: 30,
            reload_s: 1.6,
            range_m: 35.0,
            falloff_start_m: 8.0,
            falloff_min: 0.2,
            impulse: 7.0,
            kick_deg: 4.5,
            hit_stop_s: 0.05,
            drop_ammo: (2, 4),
            beam_color: (1.0, 0.25, 0.35),
            beam_width: 0.035,
            beam_life_s: 0.12,
            muzzle_light: 5.0,
            noise_m: 70.0,
        ),
        (
            id: "rock",
            name_key: "WEAPON_ROCK",
            kind: Thrown,
            // Infinite, pathetic, funny.
            damage: 6.0,
            pellets: 1,
            spread_deg: 0.0,
            aim_spread_deg: 0.0,
            moving_spread_deg: 0.0,
            fire_interval_s: 0.6,
            automatic: false,
            magazine: 0,
            start_reserve: 0,
            max_reserve: 0,
            reload_s: 0.0,
            range_m: 0.0,
            falloff_start_m: 0.0,
            falloff_min: 1.0,
            impulse: 2.0,
            kick_deg: 0.0,
            hit_stop_s: 0.0,
            drop_ammo: (0, 0),
            throw_speed: 16.0,
            throw_up: 0.12,
            noise_m: 8.0,
        ),
        (
            id: "bat",
            name_key: "WEAPON_BAT",
            kind: Melee,
            // Rare, found. Knocks enemies into absurd ragdolls.
            damage: 40.0,
            pellets: 1,
            spread_deg: 0.0,
            aim_spread_deg: 0.0,
            moving_spread_deg: 0.0,
            fire_interval_s: 0.55,
            automatic: false,
            magazine: 0,
            start_reserve: 0,
            max_reserve: 0,
            reload_s: 0.0,
            range_m: 2.4,
            falloff_start_m: 0.0,
            falloff_min: 1.0,
            impulse: 14.0,
            kick_deg: 2.0,
            hit_stop_s: 0.06,
            drop_ammo: (0, 0),
            noise_m: 6.0,
        ),
    ],
    // What the player carries at the start of a run (gun slot, melee slot).
    start_gun: "rifle",
    start_melee: None,
    // The bare-handed shove when no melee weapon is carried.
    shove: (damage: 8.0, range_m: 2.0, impulse: 6.0, interval_s: 0.6),
    // Hit feedback (section 7): hit marker, ping and brief hit-stop.
    hit_marker_s: 0.18,
    // Hit-stop slows time to this scale for hit_stop_s (real time).
    hit_stop_time_scale: 0.08,
    // Camera kick on firing (toggleable; section 10).
    camera_kick: true,
    // Field of view while aiming, and how fast it eases in.
    aim_fov: 52.0,
    aim_ease_s: 0.12,
    // The gun in your hands: smaller than the world model so it never fills
    // the Deck's screen. Offsets are metres from the camera (x right, y up,
    // z back).
    // Rope gun (RB / B on keyboard; exempt from the loadout): 3 shots per
    // run, misses count. A roped soldier drops its gun and can be carried
    // (X / E) and put down again.
    rope: (
        shots_per_run: 3,
        range_m: 22.0,
        color: (0.95, 0.78, 0.42),
        width: 0.02,
        beam_life_s: 0.5,
        pick_range_m: 2.6,
        pick_facing: 0.8,
        carry_offset: (0.8, -1.1, 0.1),
        drop_push_mps: 1.0,
        noise_m: 8.0,
        coils: [(1.32, 0.46, 8.0), (1.08, 0.44, 10.0), (0.62, 0.30, 6.0), (0.30, 0.26, 4.0)],
        coil_thickness: 0.035,
    ),
    view: (
        scale: 0.45,
        hip: (0.15, -0.15, -0.3),
        aim: (0.0, -0.075, -0.26),
        thrown: (0.2, -0.2, -0.36),
        fill_energy: 0.6,
        fill_range_m: 1.5,
    ),
)
