// On-foot movement for the first-person player (CLAUDE.md section 6).
// Starting values for the Phase 0 sphere-walk test; tune freely.
// Distances in metres, speeds in m/s, accelerations in m/s^2, angles in degrees.
(
    walk_speed: 5.0,
    crouch_speed: 2.2,
    ground_acceleration: 40.0,
    air_acceleration: 8.0,
    jump_speed: 5.5,
    max_fall_speed: 60.0,

    capsule_radius: 0.4,
    capsule_height: 1.8,
    // Camera height above the capsule centre.
    eye_height: 0.7,
    crouch_eye_height: 0.2,
    crouch_blend_speed: 10.0,

    // How fast the body turns to stay upright as gravity changes direction.
    align_speed_deg: 240.0,

    // Right stick look speed at full tilt, and mouse degrees per pixel.
    stick_look_speed_deg: 160.0,
    mouse_sensitivity_deg: 0.12,
    pitch_limit_deg: 89.0,
    invert_y: false,

    // Gap between the feet and the ground when the scene starts.
    spawn_height: 0.5,
    field_of_view: 80.0,
)
