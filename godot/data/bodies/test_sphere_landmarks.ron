// NASA hardware on and around the test sphere (models: NASA 3D Resources,
// decimated to the section 11 budgets; flags and lettering removed).
// Scales bring each model to roughly its real size.
(
    surface: [
        // Stand-in for the starter lander until Phase 4 builds the flyable one.
        (name: "ParkedLunarModule", model: "res://assets/models/nasa/apollo_lunar_module.glb",
         at: (0.073, 0.9945, -0.073), scale: 1.4, yaw_deg: 35.0, sink_m: 0.2, solid: true),
        // Ground dish: a landmark you can see from the mesa (Phase 8 makes dishes switchable).
        (name: "TrackingDish", model: "res://assets/models/nasa/dsn_34m_dish.glb",
         at: (-0.42, 0.88, -0.2), scale: 0.6, yaw_deg: 200.0, sink_m: 0.3, solid: true),
        // A probe that came down hard: a derelict to find.
        (name: "VikingWreck", model: "res://assets/models/nasa/viking_lander.glb",
         at: (0.25, 0.92, 0.3), scale: 0.2, yaw_deg: 70.0, tilt_deg: 17.0, sink_m: 0.5, solid: true),
    ],
    orbiters: [
        (name: "Hubble", model: "res://assets/models/nasa/hubble.glb", scale: 0.025,
         orbit_radius_m: 205.0, period_s: 150.0, inclination_deg: 28.0, node_deg: 0.0, phase_deg: 250.0,
         spin_deg_s: (0.0, 2.0, 0.0)),
        (name: "Tdrs", model: "res://assets/models/nasa/tdrs.glb", scale: 20.0,
         orbit_radius_m: 260.0, period_s: 240.0, inclination_deg: 6.0, node_deg: 90.0, phase_deg: 300.0),
        (name: "Voyager", model: "res://assets/models/nasa/voyager.glb", scale: 38.0,
         orbit_radius_m: 300.0, period_s: 330.0, inclination_deg: 62.0, node_deg: 140.0, phase_deg: 200.0,
         spin_deg_s: (0.0, 0.0, 1.5)),
    ],
)
