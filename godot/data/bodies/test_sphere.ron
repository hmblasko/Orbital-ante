// PLACEHOLDER body for the Phase 0 sphere-walk test scene.
// Not part of the body roster; it is deliberately smaller than a moon
// (section 4: moons are 150-400 m) so the curvature is easy to feel.
(
    name: "Test Sphere (placeholder)",
    radius: 60.0,
    gravity: (
        surface_gravity: 9.0,
        // Small enough that a zero-g gap separates it from the test moonlet.
        influence_radius: 150.0,
    ),
    // No atmosphere: vacuum, like the Moon, so the suit uses oxygen.
    placeholder_look: (
        base_color: (0.78, 0.74, 0.68),
        noise_frequency: 0.05,
        // How many times the noise texture repeats across one radius.
        texture_repeats: 6.0,
        radial_segments: 128,
        rings: 64,
        marker_count: 24,
        marker_size: (0.6, 3.0, 0.6),
        marker_color: (0.95, 0.55, 0.2),
    ),
)
