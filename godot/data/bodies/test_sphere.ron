// PLACEHOLDER body for the Phase 0 sphere-walk test scene.
// Not part of the body roster; it is deliberately smaller than a moon
// (section 4: moons are 150-400 m) so the curvature is easy to feel.
(
    name: "Test Sphere (placeholder)",
    radius: 60.0,
    gravity: (
        surface_gravity: 9.0,
        // Small enough that a zero-g gap separates it from the test moonlet.
        influence_radius: 150.0,
    ),
    // No atmosphere: vacuum, like the Moon, so the suit uses oxygen.
    terrain: (
        seed: 4217,
        // 96 x 96 cells per cube face: about 110k triangles.
        subdivisions: 96,
        hill_height_m: 1.3,
        hill_frequency: 3.5,
        hill_octaves: 5,
        ridge_height_m: 1.6,
        ridge_frequency: 2.2,
        crater_count: 22,
        crater_radius_m: (2.5, 11.0),
        crater_depth_ratio: 0.2,
        crater_rim_ratio: 0.35,
    ),
    // Warm grey regolith with cool shadows (Moon-like, painted, not photoreal).
    look: (
        color_low: (0.50, 0.47, 0.45),
        color_high: (0.82, 0.78, 0.72),
        color_crater: (0.36, 0.34, 0.35),
        color_rim: (0.92, 0.89, 0.82),
        color_slope: (0.56, 0.51, 0.47),
        shadow_tint: (0.40, 0.44, 0.60),
        rim_color: (0.55, 0.66, 1.0),
        rim_strength: 0.35,
        detail_scale: 0.03,
        grain_scale: 0.15,
    ),
    rocks: (
        count: 90,
        size_m: (0.35, 2.6),
        cluster_size: (2, 6),
        cluster_spread_m: 5.0,
        roughness: 0.32,
        color: (0.66, 0.61, 0.56),
        color_dark: (0.34, 0.31, 0.30),
    ),
)
