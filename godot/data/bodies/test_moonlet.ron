        rim_color: (0.65, 0.80, 1.0),
        rim_strength: 0.3,
        detail_scale: 0.05,
        grain_scale: 0.18,
    ),
    land_look: (
        // Blue-grey ice strata in the crevasse walls.
        strata_a: (0.60, 0.72, 0.84),
        strata_b: (0.38, 0.50, 0.66),
        basalt: (0.22, 0.26, 0.34),
