// PLACEHOLDER second body for the Phase 2 suit test: a jetpack hop away from
// the test sphere, with a zero-g gap between their gravity fields.
// Not part of the body roster. An icy little world so the hop lands somewhere
// that feels different: frozen pools you can skate across, frost-capped
// ridges and a crevasse (section 4: menacing geography, never flat).
(
    name: "Test Moonlet (placeholder)",
    radius: 22.0,
    gravity: (
        surface_gravity: 4.0,
        influence_radius: 70.0,
    ),
    // Breathable air, so the "refill outside a suit" rule can be tested.
    // PLACEHOLDER: no real moon has this; it's here for testing only.
    atmosphere: Some((
        breathable: true,
        height_m: 8.0,
    )),
    terrain: (
        seed: 905,
        // 64 cells per face edge: about 0.5 m cells, enough for small ridges.
        subdivisions: 64,
        hill_height_m: 0.8,
        hill_frequency: 3.0,
        hill_octaves: 4,
        ridge_height_m: 0.9,
        ridge_frequency: 2.5,
        crater_count: 7,
        crater_radius_m: (1.5, 4.0),
        crater_depth_ratio: 0.22,
        crater_rim_ratio: 0.3,
        landforms: (
            // Below this, the ground is under ice.
            water_level_m: Some(-0.5),
            clear_zone_deg: 0.0,
            placed: [],
            random: [
                (kind: Mountain, count: 3, radius_m: (5.0, 8.0), height_m: (3.0, 5.0)),
                (kind: Canyon, count: 1, radius_m: (1.6, 2.0), height_m: (1.5, 2.0), length_m: (20.0, 28.0)),
                (kind: Lake, count: 1, radius_m: (5.0, 6.0), height_m: (1.2, 1.5)),
                (kind: Pool, count: 3, radius_m: (1.8, 2.5), height_m: (0.8, 1.0)),
            ],
        ),
    ),
    // Icy blue-white, so it reads as a different place from far away.
    look: (
        color_low: (0.50, 0.62, 0.76),
        color_high: (0.70, 0.80, 0.90),
        color_crater: (0.30, 0.42, 0.57),
        color_rim: (0.88, 0.93, 0.98),
        color_slope: (0.40, 0.52, 0.66),
