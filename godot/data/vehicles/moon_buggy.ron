// The Moon buggy (CLAUDE.md section 5: NASA rovers drivable in first
// person; dune-buggy rovers get rocket boosts). A cartoon take on the
// Apollo Lunar Roving Vehicle: open tub, roll hoops, gold foil panels,
// the umbrella antenna, fat tyres and a rocket on the back.
//
// Vehicle space: +Z forward, +Y up, metres. Forces are written as
// accelerations (m/s^2) so the buggy feels the same whatever its mass.
(
    mass_kg: 600.0,
    // Low centre of mass: it tips in hard turns but rarely rolls on flat ground.
    center_of_mass: (0.0, 0.45, 0.0),
    angular_damp: 0.6,
    friction: 0.6,
    bounce: 0.1,
    // Body collision (the wheels are rays, below).
    hull: [
        (size: (1.9, 0.55, 3.3), at: (0.0, 0.85, 0.0)),
        // The roll hoops: keep the buggy off its driver when upside down.
        (size: (1.5, 0.3, 1.4), at: (0.0, 1.95, -0.25)),
    ],
    wheels: (
        radius_m: 0.48,
        width_m: 0.38,
        // Suspension: ray starts at the mount and reaches rest_m + radius.
        rest_m: 0.5,
        // Spring and damper per wheel, as acceleration per metre of
        // compression and per m/s of compression speed.
        spring: 30.0,
        damper: 6.0,
        // Sideways grip (1/s) and the tyre's friction coefficient.
        grip: 9.0,
        mu: 1.3,
        // Grip never uses less than this much "weight" (m/s^2): on the
        // Moon's 3 m/s^2 the buggy would otherwise slide like soap.
        // Applied the same everywhere, so the handling stays learnable.
        grip_floor_mps2: 6.0,
        mounts: [
            (pos: (0.95, 0.75, 1.25), steer: true, drive: true),
            (pos: (-0.95, 0.75, 1.25), steer: true, drive: true),
            (pos: (0.95, 0.75, -1.25), steer: false, drive: true),
            (pos: (-0.95, 0.75, -1.25), steer: false, drive: true),
        ],
    ),
    drive: (
        accel_mps2: 6.5,
        top_speed_mps: 17.0,
        reverse_mps: 6.0,
        brake_mps2: 9.0,
        // Rolling resistance (1/s) when coasting.
        coast_drag: 0.25,
        steer_deg: 30.0,
        steer_speed_deg_s: 140.0,
        // Steering narrows with speed: steer x 1 / (1 + speed / this).
        steer_falloff_mps: 14.0,
        // Handbrake (crouch): rear grip x this, for drifts.
        handbrake_grip: 0.25,
    ),
    // Rocket boost on A / Space.
    boost: (
        accel_mps2: 13.0,
        fuel_s: 3.0,
        // Seconds of fuel back per second while not boosting (Hot Rod x2).
        recharge_per_s: 0.5,
        // Boost can push past top speed up to this.
        top_speed_mps: 30.0,
    ),
    // In the air the stick tilts the buggy (deg/s^2), so you can land it.
    air_control_deg_s2: 160.0,
    // ...up to this spin rate (deg/s) on pitch and roll.
    air_rate_deg_s: 90.0,
    // Tipped over and nearly stopped: hold A to roll back upright.
    righting: (tilt_deg: 70.0, max_speed_mps: 3.0, rate_deg_s: 90.0),
    // The driver (left seat, like the LRV; +X is left): sit point (player body centre), where you climb out, and
    // how close you must be to get in.
    seat_at: (0.38, 1.55, -0.35),
    exit_at: (2.0, 1.2, -0.3),
    enter_range_m: 3.2,
    look_yaw_limit_deg: 150.0,
    // Crashes: chassis impacts faster than this hurt the driver (open
    // cockpit), by hurt_per_mps for each m/s over (Hot Rod x1.4).
    crash: (safe_mps: 7.0, hurt_per_mps: 9.0),
    // Enemies hear the motor (section 6: engines draw attention).
    engine_noise_m: 35.0,
    engine_noise_every_s: 0.5,
    // Parked buggies are frozen into the ground until you come close.
    wake_m: 90.0,
    park_m: 220.0,
    look: (
        body: (0.86, 0.86, 0.82),
        trim: (0.25, 0.72, 0.74),
        foil: (0.93, 0.70, 0.25),
        dark: (0.16, 0.17, 0.19),
        tyre: (0.20, 0.20, 0.21),
        seat: (0.30, 0.42, 0.62),
        lamp: (1.0, 0.92, 0.75),
        flame: (1.0, 0.55, 0.18),
        headlight_energy: 3.0,
        headlight_range_m: 24.0,
    ),
)
