// Cockpit dash styles (CLAUDE.md section 5: three switchable dash variants,
// one of them black screen with green text; every gauge looks different).
// Press F4 aboard a ship to cycle them. Colours are 0-1 RGB(A).
(
    // Size of the dash's own render target, in pixels.
    viewport_px: (1024, 512),
    // Which style a new ship starts with (index into `styles`).
    default_style: 0,
    // Full-scale values for dials and tapes.
    speed_full_scale_mps: 80.0,
    vertical_full_scale_mps: 20.0,
    altitude_tape_span_m: 200.0,
    // Below this speed the drift ball shows "holding still".
    drift_min_mps: 0.3,
    // Warnings.
    low_fuel: 0.2,
    low_oxygen: 0.25,
    low_hull: 0.3,
    warning_blink_hz: 2.0,
    // How long the style's name shows after switching, seconds.
    style_banner_s: 1.6,
    styles: [
        (
            kind: Toon,
            name_key: "DASH_STYLE_TOON",
            number_font: "res://assets/fonts/LilitaOne-Regular.ttf",
            label_font: "res://assets/fonts/Fredoka-Variable.ttf",
            background: (0.11, 0.13, 0.17),
            panel: (0.19, 0.22, 0.28, 1.0),
            panel_edge: (0.35, 0.39, 0.47, 1.0),
            text: (0.96, 0.94, 0.88),
            dim: (0.62, 0.64, 0.68),
            speed: (1.0, 0.78, 0.30),
            altitude: (0.45, 0.82, 1.0),
            fuel: (1.0, 0.62, 0.22),
            oxygen: (0.35, 0.92, 0.88),
            drift: (0.55, 1.0, 0.55),
            warning: (1.0, 0.36, 0.26),
            needle: (0.1, 0.1, 0.1),
            corner_px: 22,
            scanlines: 0.0,
        ),
        (
            kind: Analog,
            name_key: "DASH_STYLE_ANALOG",
            number_font: "res://assets/fonts/LilitaOne-Regular.ttf",
            label_font: "res://assets/fonts/Fredoka-Variable.ttf",
            background: (0.20, 0.18, 0.15),
            panel: (0.93, 0.89, 0.78, 1.0),
            panel_edge: (0.72, 0.56, 0.28, 1.0),
            text: (0.14, 0.12, 0.10),
            dim: (0.45, 0.40, 0.33),
            speed: (0.78, 0.22, 0.14),
            altitude: (0.16, 0.32, 0.55),
            fuel: (0.85, 0.45, 0.10),
            oxygen: (0.10, 0.50, 0.45),
            drift: (0.15, 0.45, 0.15),
            warning: (0.85, 0.12, 0.08),
            needle: (0.12, 0.10, 0.08),
            corner_px: 14,
            scanlines: 0.0,
        ),
        (
            kind: Terminal,
            name_key: "DASH_STYLE_TERMINAL",
            number_font: "res://assets/fonts/VT323-Regular.ttf",
            label_font: "res://assets/fonts/VT323-Regular.ttf",
            background: (0.01, 0.03, 0.01),
            panel: (0.02, 0.07, 0.03, 1.0),
            panel_edge: (0.12, 0.45, 0.18, 1.0),
            text: (0.36, 1.0, 0.45),
            dim: (0.16, 0.50, 0.22),
            speed: (0.36, 1.0, 0.45),
            altitude: (0.36, 1.0, 0.45),
            fuel: (0.36, 1.0, 0.45),
            oxygen: (0.36, 1.0, 0.45),
            drift: (0.70, 1.0, 0.70),
            warning: (1.0, 0.85, 0.30),
            needle: (0.36, 1.0, 0.45),
            corner_px: 6,
            scanlines: 0.18,
        ),
    ],
)
