// The starter lander (CLAUDE.md sections 5 and 17.3): based on the Apollo
// Lunar Module (NASA 3D Resources model, flags and lettering removed), at a
// chunky game scale so the player can walk under its belly and stand up
// inside. Ship space: metres, +Y up, +Z forward (the windows), the footpads
// rest on y = 0.
// Flight numbers are starting values; tune from playtests.
(
    model: "res://assets/models/nasa/apollo_lunar_module.glb",
    model_scale: 2.4,
    // Lowers the model so the footpads sit on y = 0.
    model_offset: (0.0, -0.24, 0.0),
    // The model's descent engine bell, for the thrust glow (ship space).
    engine_at: (0.0, 1.1, 0.0),

    mass_kg: 4000.0,
    // Low, in the heavy descent stage, so the lander stays upright on slopes.
    center_of_mass: (0.0, 1.5, 0.0),
    angular_damp: 0.5,
    // Physics material for the footpads and hull.
    friction: 1.0,
    bounce: 0.05,

    flight: (
        // Thrust accelerations in m/s^2 (Earth's surface gravity is 9.8).
        forward: 12.0,
        back: 8.0,
        strafe: 8.0,
        up: 22.0,
        down: 10.0,
        // Turning: top rates in degrees per second, and how fast the ship
        // reaches them. With flight assist on, the ship stops turning by
        // itself when you let go of the stick.
        pitch_rate_deg: 70.0,
        yaw_rate_deg: 70.0,
        roll_rate_deg: 90.0,
        turn_accel_deg: 260.0,
        // Mouse: degrees per second of turn per pixel moved in one tick.
        mouse_turn_deg: 1.4,
        flight_assist: true,
        // Match velocity: brakes to zero speed relative to the body you are
        // near, at this deceleration.
        match_velocity_accel: 15.0,
        // Fuel in seconds of full main thrust; thrusters use it in
        // proportion to how hard they push.
        fuel_s: 300.0,
        // Below this speed relative to the ground the ship counts as landed.
        landed_speed: 0.6,
    ),

    cabin: (
        // The cabin is a rounded bowl inside the ascent stage.
        floor_y: 6.2,
        wall_top_y: 9.0,
        dome_top_y: 10.0,
        radius_x: 1.85,
        radius_z: 2.7,
        center_z: 0.0,
        // Its own gravity, pointing at the cabin floor.
        gravity: 9.8,
        // Front windows: centre angle (0 = straight ahead, + to the right),
        // half-width in degrees at the top, bottom and top heights. Narrower
        // at the bottom (taper 0.55 = 55% as wide), like the real LM's
        // triangular windows.
        windows: [
            (angle_deg: -21.0, half_width_deg: 15.0, bottom_y: 7.35, top_y: 8.65, taper: 0.55),
            (angle_deg: 21.0, half_width_deg: 15.0, bottom_y: 7.35, top_y: 8.65, taper: 0.55),
        ],
        seat_at: (0.0, 6.75, 0.35),
        // How close you must be to buckle in.
        seat_reach_m: 1.6,
        console_z: 1.95,
        light_energy: 2.2,
        light_range_m: 7.0,
        light_color: (1.0, 0.86, 0.7),
    ),

    hatch: (
        // Belly hatch: a vertical shaft through the descent stage, with a
        // blue gravity ring at the bottom (Outer Wilds-style).
        at_x: 0.0,
        at_z: -1.4,
        // Visual opening radius, and the solid collision opening (square
        // half-width) that the hatch rim covers.
        radius: 0.65,
        collision_half: 0.5,
        // Bottom of the descent stage, where the ring is.
        ring_y: 1.92,
        ring_color: (0.25, 0.65, 1.0),
        ring_energy: 2.5,
        // The lift beam reaches from the ground to the cabin floor, this wide.
        beam_radius: 0.85,
        lift_speed: 3.2,
        top_above_floor: 0.45,
        top_drift_speed: 2.5,
        clear_margin: 0.35,
        lift_accel: 14.0,
        // Sideways pull toward the middle of the shaft.
        center_pull: 6.0,
        // How close (horizontal) to the hatch you must stand inside to open it.
        reach_m: 1.4,
        open_s: 0.6,
    ),

    // Collision, in ship space (metres). Boxes: centre, size, and yaw in
    // degrees. Capsules: two end points and a radius. Plus the cabin walls,
    // which are generated around the bowl.
    boxes: [
        // Descent stage, built around the hatch shaft.
        (center: (-2.15, 3.755, 0.0), size: (2.9, 3.67, 7.2)),
        (center: (2.15, 3.755, 0.0), size: (2.9, 3.67, 7.2)),
        (center: (0.0, 3.755, -2.85), size: (1.4, 3.67, 1.5)),
        (center: (0.0, 3.755, 1.45), size: (1.4, 3.67, 4.3)),
        // Cabin floor slab, around the hatch opening.
        (center: (-1.275, 5.9, 0.0), size: (1.55, 0.62, 5.6)),
        (center: (1.275, 5.9, 0.0), size: (1.55, 0.62, 5.6)),
        (center: (0.0, 5.9, -2.35), size: (1.0, 0.62, 0.9)),
        (center: (0.0, 5.9, 0.95), size: (1.0, 0.62, 3.7)),
        // Roof.
        (center: (0.0, 10.3, 0.0), size: (5.0, 0.6, 6.4)),
        // Descent engine bell.
        (center: (0.0, 1.5, 0.0), size: (1.7, 0.85, 1.7)),
    ],
    capsules: [
        (from: (7.1, 0.35, 0.0), to: (3.5, 3.4, 0.0), radius: 0.22),
        (from: (-7.1, 0.35, 0.0), to: (-3.5, 3.4, 0.0), radius: 0.22),
        (from: (0.0, 0.35, 7.1), to: (0.0, 3.4, 3.5), radius: 0.22),
        (from: (0.0, 0.35, -7.1), to: (0.0, 3.4, -3.5), radius: 0.22),
        // Footpads (short fat capsules lying flat).
        (from: (6.6, 0.3, 0.0), to: (7.6, 0.3, 0.0), radius: 0.3),
        (from: (-6.6, 0.3, 0.0), to: (-7.6, 0.3, 0.0), radius: 0.3),
        (from: (0.0, 0.3, 6.6), to: (0.0, 0.3, 7.6), radius: 0.3),
        (from: (0.0, 0.3, -6.6), to: (0.0, 0.3, -7.6), radius: 0.3),
    ],
    // Cabin wall collision: this many boxes around the bowl, this thick.
    wall_segments: 20,
    wall_thickness: 0.6,
    // Test scenes park the lander on the flattest of these spots: this much
    // further than spawn_ahead_m, at these bearings from straight ahead.
    // Cockpit parts (Phase 4 part 2): dash screen on the console, the
    // little thrust-display model, and the cameras Y cycles through.
    cockpit: (
        screen_size_m: (1.2, 0.6),
        screen_at: (0.0, 7.72, 2.18),
        screen_tilt_deg: 28.0,
        mini_ship: (
            // Console-top space: x toward the pilot's left, z toward the windows.
            at: (0.74, 0.1, -0.1),
            scale: 0.02,
            arrow_len_m: 0.08,
            arrow_color: (0.45, 0.9, 1.0),
            arrow_energy: 1.0,
            pedestal_radius_m: 0.11,
        ),
        cameras: [
            (
                name_key: "CAM_LANDING",
                at: (0.0, 1.75, 2.4),
                look_at: (0.0, -8.0, 7.5),
                up: (0.0, 0.0, 1.0),
                fov_deg: 80.0,
            ),
            (
                name_key: "CAM_SELFIE_LEFT",
                at: (4.6, 11.5, -5.5),
                look_at: (0.0, 5.0, 0.5),
                up: (0.0, 1.0, 0.0),
                fov_deg: 70.0,
                pole_from: Some((2.0, 8.6, -1.6)),
            ),
            (
                name_key: "CAM_SELFIE_RIGHT",
                at: (-4.6, 11.5, -5.5),
                look_at: (0.0, 5.0, 0.5),
                up: (0.0, 1.0, 0.0),
                fov_deg: 70.0,
                pole_from: Some((-2.0, 8.6, -1.6)),
            ),
        ],
        camera_frame: (
            border_px: 26.0,
            label_px: 44,
            color: (0.75, 1.0, 0.8, 0.9),
            rec_color: (1.0, 0.25, 0.2),
            hint_key: "CAM_HINT",
        ),
    ),
    parking: (
        extra_distances_m: [0.0, 5.0, 10.0, 15.0],
        bearings_deg: [0.0, 30.0, -30.0, 60.0, -60.0, 90.0, -90.0, 120.0, -120.0, 150.0, -150.0, 180.0],
        order_penalty_m: 0.02,
        drop_height_m: 0.4,
    ),
)
