// Visor HUD layout (CLAUDE.md section 6). Pixel sizes are for 1280x800, the
// Steam Deck screen; text stays at or above section 15's 9 px minimum.
// Colours: oxygen teal and fuel amber are friendly/neutral reads; the
// warning is red-orange, the hostile/danger colour from section 10.
(
    margin_px: 28.0,
    oxygen_ring_radius_px: 38.0,
    oxygen_ring_width_px: 7.0,
    fuel_bar_size_px: (16.0, 96.0),
    health_bar_size_px: (220.0, 6.0),
    tank_pip_radius_px: 6.0,
    font_size_px: 18,
    recap_font_size_px: 34,
    warning_blink_hz: 2.0,
    oxygen_color: (0.35, 0.85, 0.85),
    fuel_color: (0.98, 0.72, 0.3),
    health_color: (0.9, 0.92, 0.95),
    warning_color: (1.0, 0.38, 0.2),
    track_alpha: 0.25,
    recap_input_delay_s: 1.5,
)
