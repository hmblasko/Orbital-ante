// Live system map on the wrist screen (CLAUDE.md section 6: "Map opened from
// the cockpit or a wrist screen, showing live orbits. No map icons for
// undiscovered places."). Sizes are pixels at 1280x800 and scale with the
// window height. The game keeps running while the map is open.
(
    // The wrist screen panel, raised from the top edge so the oxygen and
    // jetpack gauges stay readable below it.
    panel_px: (1060.0, 570.0),
    panel_top_px: 30.0,
    corner_px: 22,
    bezel_px: 10.0,
    // Seconds for the screen to raise or lower.
    open_s: 0.18,
    // Half the visible height (the map's shorter side) in metres at each
    // zoom step, widest first.
    // The widest step is centred on the sun; the others on the player.
    zoom_half_height_m: [38000.0, 14000.0, 5000.0, 1800.0],
    start_zoom: 1,
    // Seconds to glide between zoom steps.
    zoom_glide_s: 0.25,
    // Points drawn per orbit loop.
    orbit_points: 96,
    orbit_width_px: 1.6,
    orbit_alpha: 0.32,
    // Bodies are drawn at true size, but never smaller than this.
    min_body_px: 3.5,
    sun_glow_px: 22.0,
    label_font_px: 15,
    title_font_px: 26,
    hint_font_px: 15,
    // Labels are hidden when the dot is smaller than this and the body
    // is a moon, or when they would overlap a more important label (the
    // body you are near first, then bigger bodies).
    moon_label_min_px: 5.0,
    player_marker_px: 11.0,
    // Scale bar target length.
    scale_bar_px: 140.0,
    // Colours.
    screen_color: (0.03, 0.05, 0.09, 0.90),
    bezel_color: (0.16, 0.18, 0.22, 1.0),
    grid_color: (0.36, 0.80, 0.84, 0.07),
    text_color: (0.86, 0.94, 0.96),
    player_color: (0.36, 0.90, 0.88),
    frame_ring_color: (0.36, 0.90, 0.88, 0.75),
)
